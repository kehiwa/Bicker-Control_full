BICKER_HOST=0.0.0.0
BICKER_PORT=8000
BICKER_STATE_DB=/var/lib/bicker-control/state.sqlite3
BICKER_SERIAL_PORT=/dev/ttyAMA1
BICKER_BAUDRATE=38400
BICKER_SERIAL_TIMEOUT=0.05
BICKER_SESSION_TTL=28800
BICKER_GPIO_BACKEND=lgpio
BICKER_GPIO_CHIP=0
BICKER_NETWORK_BACKEND=nmcli
# Set both values to enable HTTPS in the service.
