[Unit]
Description=Bicker Control UPS controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bicker-control
Group=bicker-control
SupplementaryGroups=dialout
EnvironmentFile=-/etc/bicker-control/bicker-control.env
ExecStart=/usr/local/bin/bicker-control
Restart=on-failure
RestartSec=5
StateDirectory=bicker-control
ConfigurationDirectory=bicker-control
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bicker-control /etc/bicker-control

[Install]
WantedBy=multi-user.target